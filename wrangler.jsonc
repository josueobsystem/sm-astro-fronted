{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sm-astro-frontend",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_API_BASE_URL": "https://api-dev.soniamorales.pe",
    "PUBLIC_SITE_URL": "https://sm-astro-fronted.josueoblitas15.workers.dev/",
    "PUBLIC_NIUBIZ_CHECKOUT_JS_URL": "https://static-content-qas.vnforapps.com/env/sandbox/js/checkout.js"
  }
}
