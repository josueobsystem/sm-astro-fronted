{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sm-astro-fronted-production",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
}
