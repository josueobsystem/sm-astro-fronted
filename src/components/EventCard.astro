---
import { formatDate, formatTime } from '@/lib/api';
import { truncateWords } from '@/lib/text';
import type { PublicEvent } from '@/types/api';

interface Props {
  event: PublicEvent;
}

const { event } = Astro.props;
const mobileImage = event.banner_sm_url || event.banner_url || '/event-placeholder.svg';
const displayTitle = truncateWords(event.title, 20) || event.title;
const hasPrice = event.min_price !== null && event.min_price !== undefined;
const priceText = hasPrice ? Number(event.min_price || 0).toFixed(2) : '';
---

<a class="event-card" href={`/${event.slug}`} aria-label={`Comprar entradas para ${event.title}`}>
  <div class="event-card__media">
    <img src={mobileImage} alt={event.title} loading="lazy" decoding="async" />
  </div>

  <div class="event-card__content">
    <h3 class="event-card__title">{displayTitle}</h3>
    <p class="event-card__datetime">
      <time datetime={event.start_at || undefined}>
        {formatDate(event.start_at)} {formatTime(event.start_at)}
      </time>
    </p>

    {event.venue_address && <div class="event-card__location">{event.venue_address}</div>}

    <div class="event-card__footer">
      <div class="event-card__price-box">
        <div>
          <p class="event-card__price-label">Desde</p>
          <p class="event-card__price">
            {hasPrice ? <><span class="currency">S/</span> {priceText}</> : 'Pronto'}
          </p>
        </div>
        <span class="event-card__tag">Entradas</span>
      </div>

      <span class="cta-button event-card__button">{hasPrice ? 'Comprar entradas' : 'Ver evento'}</span>
    </div>
  </div>
</a>
