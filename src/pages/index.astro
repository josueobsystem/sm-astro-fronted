---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/HomeHero.astro';
import HomeEvents from '@/components/HomeEvents.astro';
import { apiGet } from '@/lib/api';
import type { HomePayload } from '@/types/api';
import { env } from 'cloudflare:workers';

const query = Object.fromEntries(Astro.url.searchParams);
const homeResult = await apiGet<HomePayload>('/api/public/home', env, query);
const home = homeResult.ok ? homeResult.data : null;

const firstSlide = home?.slides?.[0];
const preloadImages = [
  firstSlide?.image ? { href: firstSlide.image, media: '(min-width: 768px)' } : null,
  (firstSlide?.image_sm || firstSlide?.image)
    ? { href: firstSlide?.image_sm || firstSlide?.image || '', media: '(max-width: 767px)' }
    : null,
].filter((resource): resource is { href: string; media: string } => Boolean(resource?.href));
---

<BaseLayout
  title="Sonia Morales - Entradas oficiales"
  description="Compra entradas oficiales para eventos de Sonia Morales."
  preloadImages={preloadImages}
>
  <HomeHero query={query} home={home} homeErrorMessage={homeResult.ok ? '' : homeResult.message} />

  <section class="section" id="solicitud-evento">
    <div class="shell notice-panel" style="margin-top:0">
      <p class="eyebrow">Eventos privados</p>
      <h1 class="display-title" style="font-size: clamp(2rem, 5vw, 3.6rem); line-height:1.02; max-width: 760px;">
        Solicita tu evento con Sonia Morales
      </h1>
      <p class="lead">
        Completa el formulario para bodas, fiestas privadas, aniversarios y eventos corporativos.
      </p>
      <div class="notice-panel__actions">
        <a class="cta-button" href="/service-request" style="margin-top:22px">Ir al formulario</a>
      </div>
    </div>
  </section>

  <HomeEvents query={query} home={home} homeErrorMessage={homeResult.ok ? '' : homeResult.message} />
</BaseLayout>
