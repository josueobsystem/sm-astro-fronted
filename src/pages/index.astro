---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/HomeHero.astro';
import HomeEvents from '@/components/HomeEvents.astro';

const query = Object.fromEntries(Astro.url.searchParams);
---

<BaseLayout
  title="Sonia Morales - Entradas oficiales"
  description="Compra entradas oficiales para eventos de Sonia Morales."
>
  <HomeHero server:defer query={query}>
    <section slot="fallback" class="hero-slider" aria-hidden="true">
      <div class="hero-swiper-shell" aria-hidden="true">
        <div class="hero-slide-frame">
          <div class="hero-slide-overlay"></div>
        </div>
      </div>
    </section>
  </HomeHero>

  <section class="section" id="solicitud-evento">
    <div class="shell notice-panel" style="margin-top:0">
      <p class="eyebrow">Eventos privados</p>
      <h1 class="display-title" style="font-size: clamp(2rem, 5vw, 3.6rem); line-height:1.02; max-width: 760px;">
        Solicita tu evento con Sonia Morales
      </h1>
      <p class="lead">
        Completa el formulario para bodas, fiestas privadas, aniversarios y eventos corporativos.
      </p>
      <div class="notice-panel__actions">
        <a class="cta-button" href="#contacto" style="margin-top:22px">Ir al formulario</a>
      </div>
    </div>
  </section>

  <HomeEvents server:defer query={query}>
    <section slot="fallback" class="section">
      <div class="shell" style="padding-top: 24px;">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Cartelera</p>
            <h2>Próximos eventos</h2>
          </div>
        </div>
      </div>
    </section>
  </HomeEvents>
</BaseLayout>
