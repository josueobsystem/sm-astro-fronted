---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EventCard from '@/components/EventCard.astro';
import HeroShowcase from '@/components/HeroShowcase.astro';
import VenuesSection from '@/components/VenuesSection.astro';
import { apiGet } from '@/lib/api';
import type { HomePayload } from '@/types/api';
import { env } from 'cloudflare:workers';

const query = Object.fromEntries(Astro.url.searchParams);
const homeResult = await apiGet<HomePayload>('/api/public/home', env, query);
const home = homeResult.ok ? homeResult.data : null;
---

<BaseLayout
  title={home?.seo.title || 'Sonia Morales - Entradas oficiales'}
  description={home?.seo.description || 'Compra entradas oficiales para eventos de Sonia Morales.'}
>
  {home ? (
    <>
      <HeroShowcase slides={home.slides} />

      <section class="section" id="solicitud-evento">
        <div class="shell notice-panel" style="margin-top:0">
          <p class="eyebrow">Eventos privados</p>
          <h1 class="display-title" style="font-size: clamp(2rem, 5vw, 3.6rem); line-height:1.02; max-width: 760px;">
            Solicita tu evento con Sonia Morales
          </h1>
          <p class="lead">
            Completa el formulario para bodas, fiestas privadas, aniversarios y eventos corporativos.
          </p>
          <div class="notice-panel__actions">
            <a class="cta-button" href="#contacto" style="margin-top:22px">Ir al formulario</a>
          </div>
        </div>
      </section>

      <section class="section" id="eventos">
        <div class="shell">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Cartelera</p>
              <h2>Próximos eventos</h2>
            </div>
            <span class="meta-line">
              {home.pagination.from || 0}-{home.pagination.to || 0} de {home.pagination.total}
            </span>
          </div>
          <div class="events-grid">
            {home.events.map((event) => <EventCard event={event} />)}
          </div>
        </div>
      </section>

      <VenuesSection venues={home.venues} />
    </>
  ) : (
    <section class="shell notice-panel">
      <p class="eyebrow">API no disponible</p>
      <h1>No pudimos cargar los eventos.</h1>
      <p class="lead">{homeResult.message}</p>
    </section>
  )}
</BaseLayout>
