---
const token = (Astro.url.searchParams.get('token') || '').trim();
const email = (Astro.url.searchParams.get('email') || '').trim();

if (token) {
  const target = new URL(`/reset-password/${encodeURIComponent(token)}`, Astro.url);

  if (email) {
    target.searchParams.set('email', email);
  }

  return Astro.redirect(`${target.pathname}${target.search}`, 302);
}

return Astro.redirect('/forgot-password', 302);
