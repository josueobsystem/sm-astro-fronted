---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AuthForm from '@/islands/AuthForm.vue';
import { sanitizeRedirect } from '@/lib/auth';

const visualUrl = 'https://ob-sm-systema-tickets.us-southeast-1.linodeobjects.com/web/login_web_main.webp';
const redirectTo = sanitizeRedirect(Astro.url.searchParams.get('redirect'));
---

<BaseLayout title="Register - Sonia Morales" description="Crea tu cuenta en Sonia Morales." chrome={false}>
  <section class="auth-page">
    <div class="auth-visual">
      <img src={visualUrl} alt="Sonia Morales visual" />
    </div>
    <div class="auth-panel">
      <AuthForm client:load mode="register" redirectTo={redirectTo} />
    </div>
  </section>
</BaseLayout>
