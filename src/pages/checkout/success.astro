---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TicketSuccess from '@/islands/TicketSuccess.vue';
import { apiGet } from '@/lib/api';
import { getApiBaseUrl } from '@/lib/config';
import type { CheckoutSuccessPayload, CheckoutTransaction } from '@/types/api';
import { env } from 'cloudflare:workers';

const search = Object.fromEntries(Astro.url.searchParams);
const result = await apiGet<CheckoutSuccessPayload>('/api/orders/checkout/success', env, search);
const paymentStatus = Astro.url.searchParams.get('payment_status');
const paymentWasDenied = paymentStatus !== null
  && paymentStatus !== ''
  && !/^(authorized|approved)$/i.test(paymentStatus);
const paymentTransaction: CheckoutTransaction | null = paymentStatus ? {
  status: paymentStatus || 'denied',
  purchase_number: Astro.url.searchParams.get('purchase_number'),
  transaction_date: Astro.url.searchParams.get('payment_transaction_date'),
  amount: Astro.url.searchParams.get('payment_amount'),
  currency: Astro.url.searchParams.get('payment_currency'),
  card: Astro.url.searchParams.get('payment_card'),
  brand: Astro.url.searchParams.get('payment_brand'),
  action_description: null,
} : null;
const resultPayload = result.ok
  ? result.data
  : {
      order: null,
      tickets: [],
      purchaseNumber: Astro.url.searchParams.get('purchase_number'),
      flowId: null,
      error: (result.validations?.checkout as CheckoutSuccessPayload['error']) || {
        message: result.message,
        code: `HTTP_${result.status}`,
      },
    };
const payload: CheckoutSuccessPayload = paymentWasDenied
  ? {
      ...resultPayload,
      error: {
        message: 'No pudimos aprobar tu pago.',
        code: paymentStatus || resultPayload.error?.code || 'PAYMENT_DENIED',
        transaction: paymentTransaction,
      },
    }
  : resultPayload;
---

<BaseLayout
  title={payload.error ? 'Resultado de compra - Sonia Morales' : 'Compra exitosa - Sonia Morales'}
  description="Resultado de tu compra y descarga de tickets oficiales."
  footer={false}
>
  <TicketSuccess client:load payload={payload} apiBaseUrl={getApiBaseUrl(env)} />
</BaseLayout>
