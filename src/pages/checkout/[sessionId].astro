---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CheckoutPayment from '@/islands/CheckoutPayment.vue';
import { apiGet } from '@/lib/api';
import { getAuthStatus } from '@/lib/auth';
import { getNiubizCheckoutUrl } from '@/lib/config';
import type { CheckoutReservation, HomePayload, PublicEvent } from '@/types/api';
import { env } from 'cloudflare:workers';

const { sessionId } = Astro.params;
const reservationId = Astro.url.searchParams.get('reservation_id');
// El proveedor de pagos debe regresar al mismo dominio desde el que el cliente
// abrió el checkout. No dependemos de PUBLIC_SITE_URL, que puede no estar
// definido o apuntar a otro entorno durante el despliegue.
const checkoutOrigin = Astro.url.origin;
const authStatus = await getAuthStatus(Astro.request, env);

if (!authStatus.authenticated) {
  return Astro.redirect(`/login?redirect=${encodeURIComponent(`${Astro.url.pathname}${Astro.url.search}`)}`, 302);
}

const initialContact = {
  name: authStatus.user?.name || '',
  email: authStatus.user?.email || '',
  phone: authStatus.user?.person?.phone || '',
  personId: authStatus.user?.person?.id ? String(authStatus.user.person.id) : '',
};

const reservationResult = reservationId
  ? await apiGet<CheckoutReservation>(
      `/api/orders/reservations/${reservationId}`,
      env,
      { session_id: sessionId },
    )
  : { ok: false as const, status: 422, message: 'Falta reservation_id.' };
let event: PublicEvent | null = null;

if (reservationResult.ok && reservationResult.data.event_id) {
  const homeResult = await apiGet<HomePayload>('/api/public/home', env);
  event = homeResult.ok
    ? homeResult.data.events.find((item) => item.id === reservationResult.data.event_id) || null
    : null;
}
---

<BaseLayout title="Checkout - Sonia Morales" description="Confirma y paga tus entradas oficiales." chrome={false} footer={false}>
  {reservationResult.ok ? (
    <CheckoutPayment
      client:load
      siteUrl={checkoutOrigin}
      reservation={reservationResult.data}
      event={event}
      initialContact={initialContact}
      niubizCheckoutUrl={getNiubizCheckoutUrl(env)}
    />
  ) : (
    <section class="shell success-panel">
      <>
        <p class="eyebrow">Reserva no disponible</p>
        <h1>No pudimos abrir tu checkout.</h1>
        <p class="lead">{reservationResult.message}</p>
        <a class="cta-button" href="/">Volver a eventos</a>
      </>
    </section>
  )}
</BaseLayout>
